# Required for the RSVP list to save and for /admin to work.
# Already connected on Vercel via the Marketplace Upstash/KV integration,
# which names these KV_REST_API_URL / KV_REST_API_TOKEN (the code accepts
# either that pair or the "raw" Upstash names below).
# For local dev, copy the values from your Vercel project's Environment Variables.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Password for the /admin RSVP dashboard.
ADMIN_PASSWORD=

# Fill these in if you'd like an email notification for each Bible Seminar
# RSVP submission. Get a free API key at https://resend.com
RESEND_API_KEY=
RSVP_TO_EMAIL=
RSVP_FROM_EMAIL=onboarding@resend.dev
